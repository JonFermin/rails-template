<% content_for :title, @pet.name %>
<%# Subscribes this page to the pet's refresh stream; only rendered after PetPolicy#show? passed %>
<%= turbo_stream_from @pet %>

<h1><%= @pet.name %></h1>
<p><%= @pet.location.name %> · <%= @pet.checked_in? ? "Checked in" : "Not checked in" %></p>

<% if policy(@pet).check_in? %>
  <div class="actions">
    <% if @pet.checked_in? %>
      <%= button_to "Check out", pet_check_out_path(@pet) %>
    <% else %>
      <%= button_to "Check in", pet_check_in_path(@pet) %>
    <% end %>
    <%= link_to "New daily report", new_pet_daily_report_path(@pet) %>
  </div>
<% end %>

<h2>Daily reports</h2>
<ul id="daily_reports">
  <% @daily_reports.each do |daily_report| %>
    <li id="<%= dom_id(daily_report) %>">
      <%= link_to daily_report.reported_on.to_fs(:long), daily_report %> — <%= daily_report.mood %>
      <%= render daily_report.activity_summary if daily_report.summarized? %>
    </li>
  <% end %>
</ul>
